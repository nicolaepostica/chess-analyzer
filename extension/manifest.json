{
  "manifest_version": 3,
  "name": "Chess Analyzer — Analyze free",
  "version": "0.1.0",
  "description": "Adds an \"Analyze free\" button to finished chess.com games that opens a free Stockfish Game Review.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "tcn.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
